{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danny-y1/windows-app-archive/schema/archive-entry.schema.json",
  "type": "object",
  "required": ["id", "name", "version", "source_page", "download_url", "release_tag", "asset_name", "artifact_kind", "architecture", "size_bytes", "sha256", "publish_state"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "version": {"type": "string", "minLength": 1},
    "source_class": {"enum": ["official", "store", "community", "portable", "repack", "crack", "unknown"]},
    "source_page": {"type": "string", "format": "uri"},
    "download_url": {"type": "string", "format": "uri"},
    "release_tag": {"type": "string", "minLength": 1},
    "asset_name": {"type": "string", "pattern": "^[^/\\\\]+\\.(exe|msi|deb|AppImage|zip|tar|tgz|gz|xz|bz2)$"},
    "artifact_kind": {"enum": ["windows_pe", "windows_msi", "linux_deb", "linux_appimage", "linux_archive"]},
    "architecture": {"enum": ["x86", "x64", "arm64", "unknown"]},
    "size_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authenticode": {"type": "string"},
    "publish_state": {"const": "published"}
  },
  "additionalProperties": true
}