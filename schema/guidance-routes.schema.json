{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danny-y1/windows-app-archive/schema/guidance-routes.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "routes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "match",
          "outcome",
          "fallback"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "maxLength": 80
          },
          "match": {
            "type": "object",
            "required": [
              "names",
              "intents",
              "platforms",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "intents": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "install",
                    "download"
                  ]
                }
              },
              "platforms": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "android_linuxlab",
                    "linux",
                    "windows"
                  ]
                }
              },
              "mode": {
                "const": "exact"
              }
            }
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "kind",
                  "application_query"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "install_catalog_application"
                  },
                  "application_query": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "destination_name",
                  "package",
                  "target_name"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "open_android_app_search"
                  },
                  "destination_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "package": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
                  },
                  "target_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "title",
                  "steps"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "plain_guidance"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    }
                  }
                }
              }
            ]
          },
          "fallback": {
            "enum": [
              "stop",
              "continue_standard"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
